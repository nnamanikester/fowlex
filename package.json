{
  "name": "fowlex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db": "node scripts/dev-db.mjs",
    "user:create": "tsx scripts/create-user.mts",
    "db:indexes": "tsx scripts/db-indexes.mts",
    "vercel-build": "yarn db:indexes && next build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@vercel/functions": "^3.11.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "jose": "^6.2.18",
    "lucide-react": "^1.80.0",
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "mongodb-memory-server": "^11.4.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5.1.2"
  },
  "packageManager": "yarn@1.22.22",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.{css,json,md,mjs}": [
      "prettier --write"
    ]
  }
}
