# Copy to .env.local and fill in. Real values live in the team password manager, never in the repo.

# MongoDB Atlas: fowlex-dev locally and on Preview, fowlex-prod on Production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fowlex-dev

# Signs session cookies. Generate with: openssl rand -base64 48
JWT_SECRET=

# Paystack: use the sk_test_ key everywhere except Production
PAYSTACK_SECRET_KEY=sk_test_

# Resend (emails: password resets, invites, invoices, payslips). Leave empty locally: emails are
# printed in the dev server's terminal instead.
RESEND_API_KEY=
EMAIL_FROM="Fowlex <noreply@fowlex.com>"

# Vercel Blob (receipts, contracts)
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/* routes
CRON_SECRET=
